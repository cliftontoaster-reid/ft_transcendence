# .editorconfig
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2

# Svelte, TypeScript, JavaScript, JSON, CSS, HTML, Markdown
[*.{svelte,ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,less,html,md,mdx,yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

# Rust
[*.rs]
indent_style = space
indent_size = 2
tab_width = 2

# Protocol Buffers
[*.proto]
indent_style = space
indent_size = 2
tab_width = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
tab_width = 2

# Makefiles require literal tabs for recipes
[Makefile]
indent_style = tab
tab_width = 8

# Lockfiles and generated files
[{package-lock.json,pnpm-lock.yaml,yarn.lock,Cargo.lock}]
insert_final_newline = true
trim_trailing_whitespace = false

