
Enum media_kind {
  movie
  episode
}

Table media {
  id uuid [pk, default: `gen_random_uuid()`]

  manifest_path varchar(255) [not null]

  kind media_kind [not null, default: 'movie']
  // blake3 hash of the imported source file; dedups re-scans. NULL for legacy rows.
  source_hash varchar(64) [unique]
  duration_ms bigint
  release_year smallint
  season_number int
  episode_number int
  // Where the file came from, kept as provenance even though the original is deleted post-split.
  original_path varchar(1024)
}

Table media_external_ids {
  id uuid [pk, default: `gen_random_uuid()`]
  media_id uuid [not null, ref: > media.id]
  // e.g. "imdb", "tmdb" — mirrors the ExternalPersonID proto convention.
  provider varchar(64) [not null]
  value varchar(256) [not null]

  Indexes {
    (provider, value) [unique]
    media_id [name: 'media_external_ids_media_id_idx']
  }
}

// Metadata sources that answered during enrichment (native providers and
// WASM plugins): what each descriptor reported, upserted by the import
// phase. Per-media linkage stays in media_external_ids.provider.
Table metadata_source {
  id varchar(64) [pk]
  name varchar(255) [not null]
  // Provider implementation version (the source's own descriptor field).
  version varchar(64) [not null]
  // MODEL_VERSION of the metadata model the source was built against.
  model_version varchar(64) [not null]
}

Table media_translations {
  id uuid [pk, default: `gen_random_uuid()`]
  media_id uuid [not null, ref: > media.id]
  locale varchar(35) [not null]

  title varchar(256) [not null]
  synopsis varchar(500) [not null]
  summary varchar(4000) [not null]

  fts_content tsvector
  embedding "vector(768)"

  Indexes {
    fts_content [type: gin, name: 'media_translations_fts']
    embedding [name: 'media_translations_embedding_hnsw']
    (id, locale) [unique, name: 'media_translations_id_locale']
  }

}

Enum media_image_type {
  poster
  backdrop
  logo
  banner
  still
  thumbnail
}

Table media_images {
  id uuid [pk, default: `gen_random_uuid()`]
  media_id uuid [not null, ref: > media.id]
  type media_image_type [not null]
  locale varchar(35) [not null]

  storage_path varchar(255) [not null]
}

Enum media_track_type {
  video
  audio
  subtitles
}

Table media_track {
  id uuid [pk, default: `gen_random_uuid()`]
  media_id uuid [not null, ref: > media.id]
  track_type media_track_type [not null]
  locale varchar(35) [not null]

  storage_path varchar(255) [not null]
  // Stream index of the track in the original (now deleted) container.
  track_index int [not null, default: 0]
  codec varchar(32)
  is_default boolean [not null, default: false]
  is_forced boolean [not null, default: false]
  channels smallint
  width int
  height int
  title varchar(256)
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  short_name varchar(64) [not null, unique]

  Indexes {
    short_name [name: 'rooms_short_name']
  }

}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  display_name varchar(256) [not null]
  email varchar(320)
  avatar_url varchar(2048)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  disabled boolean [not null, default: false]
}

Table oidc_identities {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  issuer varchar(2048) [not null]
  subject varchar(255) [not null]
  email varchar(320)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (issuer, subject) [unique]
  }
}

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  active_profile_id uuid [ref: > viewer_profiles.id]
  jti uuid [not null, unique]
  issued_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  last_seen_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  user_agent varchar(1024)
  ip_address inet
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(64) [not null, unique]
  description varchar(256)
  created_at timestamptz [not null, default: `now()`]
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(128) [not null, unique]
  description varchar(256)
  created_at timestamptz [not null, default: `now()`]
}

Table user_roles {
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, role_id) [pk]
  }
}

Table role_permissions {
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table viewer_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  display_name varchar(256) [not null]
  avatar_url varchar(2048)
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, display_name) [unique]
  }
}

Table watch_progress {
  profile_id uuid [not null, ref: > viewer_profiles.id]
  media_id uuid [not null, ref: > media.id]
  position_ms bigint [not null, default: 0]
  duration_ms bigint
  completed boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (profile_id, media_id) [pk]
  }
}

Table watch_history {
  id uuid [pk, default: `gen_random_uuid()`]
  profile_id uuid [not null, ref: > viewer_profiles.id]
  media_id uuid [not null, ref: > media.id]
  started_at timestamptz [not null, default: `now()`]
  watched_at timestamptz [not null, default: `now()`]
  position_ms bigint [not null, default: 0]
  duration_ms bigint
}

Table my_list {
  profile_id uuid [not null, ref: > viewer_profiles.id]
  media_id uuid [not null, ref: > media.id]
  added_at timestamptz [not null, default: `now()`]

  Indexes {
    (profile_id, media_id) [pk]
  }
}

Enum room_participent_role {
  Owner
  Admin
  User
}

Table room_participents {
  id uuid [pk, default: `gen_random_uuid()`]
  room_id uuid [not null, ref: > rooms.id]
  user_id uuid [not null, ref: > users.id]
  role room_participent_role
}
